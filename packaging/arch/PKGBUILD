pkgname=vulnmind
pkgver=0.6.1
pkgrel=1
pkgdesc="CLI security scan analyzer with offline CVE matching and optional NVD, CISA KEV, and ExploitDB intelligence."
arch=('any')
url="https://github.com/Sombra-1/vulnmind"
license=('MIT')
depends=('python' 'python-click' 'python-rich' 'python-requests' 'python-reportlab')
optdepends=('nmap: live scanning via `vulnmind scan`')
makedepends=('python-setuptools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Sombra-1/vulnmind/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python setup.py build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python setup.py install --root="$pkgdir" --optimize=1 --skip-build
}
